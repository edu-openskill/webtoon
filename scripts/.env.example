# 이 파일을 .env로 복사한 뒤 키를 채워넣으세요.
# .env는 .gitignore에 추가되어 있어 git에 올라가지 않습니다.

# OpenAI API 키 — https://platform.openai.com/api-keys 에서 발급
OPENAI_API_KEY=sk-proj-여기에-실제-키-붙여넣기

# 모델 (변경 가능)
IMAGE_MODEL=gpt-image-1

# 출력 디렉토리 (기본: 프로젝트 루트 기준 상대경로)
OUTPUT_DIR=episodes/episode-01/images

# 캐릭터 시트 출력 디렉토리
CHARACTER_SHEETS_DIR=_workspace/character-sheets

# 품질 설정 (low | medium | high)
QUALITY=medium

# 동시 생성 수 (rate limit 고려, 1~3 권장)
CONCURRENCY=2
